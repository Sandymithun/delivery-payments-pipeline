# Copy to .env and adjust. Defaults run everything locally (MinIO + DuckDB).

# ---- object storage ---------------------------------------------------------
STORAGE_BACKEND=s3                     # s3 | azure | local
S3_BUCKET=delivery-lake
S3_ENDPOINT_URL=http://minio:9000      # set to empty (S3_ENDPOINT_URL=) to use real AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=eu-west-1

# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_CONTAINER=delivery-lake

# ---- warehouse --------------------------------------------------------------
WAREHOUSE=duckdb                       # duckdb | snowflake
DBT_TARGET=duckdb                      # duckdb | snowflake  (keep in step with WAREHOUSE)

# SNOWFLAKE_ACCOUNT=xy12345.eu-west-1
# SNOWFLAKE_USER=PIPELINE_USER
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_ROLE=TRANSFORMER
# SNOWFLAKE_WAREHOUSE=TRANSFORMING
# SNOWFLAKE_DATABASE=DELIVERY
# SNOWFLAKE_STAGE=RAW.LAKE_STAGE

# ---- pipeline ---------------------------------------------------------------
ORDERS_PER_DAY=2000
